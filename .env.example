# Copy to .env for local overrides. Never commit the real .env file.
# Only needed if you want to override the local-settings defaults
# (e.g. point at Postgres instead of the sqlite fallback).

# DJANGO_SECRET_KEY=
# DATABASE_URL=postgres://user:password@localhost:5432/ddp_tracker

# Required in production (config/settings/production.py has no defaults):
# DJANGO_ADMINS=justus:justus@jonas.de,peter:peter@shaw.de
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=example.com,second.example.com
# DATABASE_URL=postgres://user:password@host:5432/ddp_tracker
# DJANGO_SECURE_SSL_REDIRECT=True

# DDP uploads (optional; defaults in config/settings/base.py):
# DDP_INCOMING_DIR=/var/lib/ddp-tracker/incoming   # uploads wait here until parsed, then are deleted
# DDP_MAX_UPLOAD_SIZE=2147483648                   # bytes (default 2 GiB)
# DDP_SIMILARITY_THRESHOLD=0.3                      # below: unusual upload, needs confirmation + approval
# TASKS_BACKEND=django_tasks.backends.immediate.ImmediateBackend   # production uses the database backend
