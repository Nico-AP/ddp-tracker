{
  "id": "example_title_and_links",
  "platforms": ["*"],
  "match": "**/*.html",
  "extract": {
    "title": {"select": "title", "take": "text"},
    "links": {
      "select": "a[href]",
      "take": "list",
      "fields": {
        "href": {"take": "attr", "name": "href"},
        "text": {"take": "text"}
      }
    }
  }
}
